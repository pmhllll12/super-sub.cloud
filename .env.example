# RDS(Aurora PostgreSQL) 연결 설정 템플릿
#
# 이 파일은 "키 이름만" 공유하기 위한 템플릿입니다. 실제 값은 절대 여기에 적지
# 마십시오. 복사해서 쓰십시오:
#
#   cp .env.example .env
#
# .env / .env.local 은 .gitignore 에 등록되어 커밋되지 않습니다.
# 이 파일(.env.example)만 커밋합니다.
#
# 엔진은 Aurora PostgreSQL(pgvector) 기준입니다. MySQL 계열이면 포트를 3306 으로
# 바꾸고 SSL 관련 키를 드라이버에 맞게 조정하십시오.


# --- 접속 대상 -------------------------------------------------------------
# 쓰기(라이터) 엔드포인트. AWS 콘솔 > Aurora and RDS > 데이터베이스 > 클러스터
# 상세의 "엔드포인트 및 포트"에서 확인합니다.
# 형식: <클러스터명>.cluster-<식별자>.<리전>.rds.amazonaws.com
RDS_HOST=


# 읽기(리더) 엔드포인트. 형식에 cluster-ro- 가 들어갑니다.
# 검색 질의를 리더로 분리할 때만 사용합니다. 쓰지 않으면 비워 두십시오.
# 형식: <클러스터명>.cluster-ro-<식별자>.<리전>.rds.amazonaws.com
RDS_READER_HOST=


RDS_PORT=5432
RDS_DB_NAME=
RDS_USER=


# --- 인증 ------------------------------------------------------------------
# 비밀번호 방식. 값을 넣는 순간 이 파일이 아니라 .env 에 있어야 합니다.
# 운영 단계에서는 아래 IAM 인증이나 Secrets Manager 로 옮기는 것을 권장합니다.
RDS_PASSWORD=


# IAM 데이터베이스 인증을 쓸 경우 true. 비밀번호 대신 15분짜리 토큰을 발급받아
# 접속하므로 자격증명을 파일에 두지 않아도 됩니다.
RDS_IAM_AUTH=false


# --- 연결 옵션 -------------------------------------------------------------
# RDS 는 전송 구간 암호화를 지원합니다. verify-full 을 쓰려면 AWS 루트 인증서
# (rds-ca-rsa2048-g1 등)를 내려받아 경로를 지정하십시오.
RDS_SSL_MODE=require
RDS_SSL_ROOT_CERT=


# 커넥션 풀 상한. Aurora Serverless v2 는 ACU 에 따라 max_connections 가 변하므로
# 최소 ACU 기준으로 잡으십시오.
RDS_POOL_MAX=10
RDS_CONNECT_TIMEOUT=10


# 위 값들을 조합한 URL. 드라이버가 URL 만 받는 경우 사용합니다.
# 형식: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=


# --- AWS -------------------------------------------------------------------
# 예: ap-northeast-2
AWS_REGION=


# 로컬 개발에서 IAM 사용자 자격증명이 필요한 경우에만 사용합니다.
# EC2/ECS/Lambda 에서 실행할 때는 비워 두고 IAM 역할을 붙이십시오 — 장기 키를
# 파일에 두지 않는 편이 안전합니다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
