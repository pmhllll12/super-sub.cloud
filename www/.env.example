# 서버 전용. NEXT_PUBLIC_ 을 붙이지 않는다 — 클라이언트 번들에 박힌다.
BACKEND_BASE_URL=http://127.0.0.1:8000/api/v1

# 1 이면 FastAPI 대신 mock 게이트웨이를 쓴다.
USE_MOCK=1

# 구글 클라우드 프로젝트 supersub 의 "웹" OAuth 클라이언트 ID. 원래 공개되는
# 값이라 NEXT_PUBLIC_ 이 맞다 (BACKEND_BASE_URL 과 달리 클라이언트 번들에
# 들어가도 문제되지 않는다). 비워두면 로그인·회원가입 화면이 구글 버튼을
# 아예 그리지 않는다.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 서버 전용. 챗봇(/api/chat, "용병 찾기" — 미결 min 7번)이 쓴다. EXAONE과는
# 완전히 분리된 별도 LLM이다 — 라이선스 이슈(미결 ho 1번·15번)와 무관하다.
# Claude가 아니라 Gemini다(2026-09-04 정정) — Google AI Studio
# (https://aistudio.google.com/apikey) 에서 카드 등록 없이 바로 키를 받는다.
# 비워두면 챗봇이 503 CHAT_NOT_CONFIGURED 를 낸다.
GEMINI_API_KEY=
