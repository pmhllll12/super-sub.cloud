# 유휴하면 인스턴스를 스스로 멈춘다 — 판정 1회.
# 주기 실행은 supersub-autostop.timer 가 맡는다.
#
# 설치는 agent/deploy/install_autostop.sh 가 한다.
# 🔴 그 전에 콘솔에서 **종료 동작이 `중지(stop)`인지** 확인할 것 —
#    `종료(terminate)`면 이 유닛이 인스턴스와 EBS를 지운다.

[Unit]
Description=Super-Sub 유휴 자동 종료 (판정 1회)
Documentation=file:/opt/supersub/autostop.sh
# 종료 중에는 판정할 필요가 없다.
DefaultDependencies=no
After=basic.target
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=oneshot
ExecStart=/opt/supersub/autostop.sh
EnvironmentFile=-/etc/supersub/autostop.conf

# poweroff 를 부르려면 root 여야 한다.
User=root

StandardOutput=journal
StandardError=journal
