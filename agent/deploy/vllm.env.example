# /etc/supersub/vllm.env 의 예시. **실제 파일은 저장소에 넣지 않는다.**
#
#   sudo mkdir -p /etc/supersub
#   sudo cp agent/deploy/vllm.env.example /etc/supersub/vllm.env
#   sudo vi /etc/supersub/vllm.env          # 버킷 이름을 채운다
#   sudo chmod 600 /etc/supersub/vllm.env
#
# 여기에 **AWS 키를 적지 않는다.** EC2는 인스턴스 프로파일(IAM 역할)로 S3에
# 접근한다 — 키를 파일에 두면 스냅샷·AMI에 딸려 나간다.

# 모델 가중치가 있는 S3 접두사. 🔴 **기본값은 비어 있다 — 그대로 둔다.**
#
# 비어 있으면 sync_model.sh 가 S3 를 건너뛰고 SUPERSUB_MODEL_DIR 의 가중치를
# 그대로 쓴다. 🔴 **S3 사본은 백업이지 기동 경로가 아니다** (2026.09.17).
# 여기에 값을 채우면 supersub-vllm 이 **기동할 때마다** S3 에 다녀오고
# (ExecStartPre=sync_model.sh), 그 호출이 실패하면 — 자격 증명·네트워크·정책
# 어느 쪽이든 — **가중치가 디스크에 멀쩡히 있는데도 서비스가 안 뜬다.**
# 얻는 것 없이 실패 지점만 하나 늘린다.
#
# 채우는 자리는 **새 인스턴스를 만들 때 한 번**이다(README 5-1의 복구 절차).
# 그때도 받고 나면 도로 비운다.
SUPERSUB_MODEL_S3=

# 로컬 캐시 경로 (EBS)
SUPERSUB_MODEL_DIR=/opt/supersub/models/exaone-4.0-1.2b

# judge.py MODELS["1.2B"]와 같아야 한다
SUPERSUB_SERVED_NAME=LGAI-EXAONE/EXAONE-4.0-1.2B

# 인증이 없으므로 루프백에만 묶는다
SUPERSUB_VLLM_HOST=127.0.0.1
SUPERSUB_VLLM_PORT=8000

# T4 16GB를 포즈 모델과 나눠 쓰는 비율 — serve_vllm.sh 주석 참고
SUPERSUB_GPU_FRACTION=0.35
SUPERSUB_MAX_MODEL_LEN=4096
SUPERSUB_ENFORCE_EAGER=1
