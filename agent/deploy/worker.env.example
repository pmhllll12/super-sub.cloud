# /etc/supersub/worker.env 의 예시. **실제 파일은 저장소에 넣지 않는다.**
#
#   sudo mkdir -p /etc/supersub
#   sudo cp agent/deploy/worker.env.example /etc/supersub/worker.env
#   sudo vi /etc/supersub/worker.env          # 토큰을 채운다
#   sudo chmod 600 /etc/supersub/worker.env
#
# 여기에 **AWS 키를 적지 않는다.** EC2는 인스턴스 프로파일(IAM 역할)로 S3에
# 접근한다 — 키를 파일에 두면 스냅샷·AMI에 딸려 나간다.

# 🔴 워커 자격 증명. **값은 저장소에 없다** — 백엔드 담당자(정어진)에게 받는다.
# 서버의 WORKER_TOKEN 과 **같은 값**이어야 한다. 한쪽만 넣으면 계속 401 이다.
# 비어 있으면 워커가 아예 시작하지 않는다(종료 코드 78, 재시작하지 않음).
SUPERSUB_WORKER_TOKEN=

# 백엔드 API. 끝의 /api/v1 까지 포함한다.
SUPERSUB_API_BASE=https://api.supersub-ai.com/api/v1

# 영상이 있는 버킷. claim 이 주는 storage_key 앞에 s3://<버킷>/ 을 붙인다.
SUPERSUB_S3_BUCKET=supersub-ai

# 리포트를 올릴 접두사. 🔴 videos/ 아래를 가리키지 않는다 — IAM 정책이
# videos/ 읽기 전용인 것이 의도다(README 2-A).
SUPERSUB_REPORTS_URI=s3://supersub-ai/reports

# 판정 백엔드. 있으면 vLLM, 없으면 로컬 적재다(judge.py). EC2에서는 있어야
# 한다 — 없으면 워커의 자식이 T4에 모델을 또 올리려 들어 vLLM 과 VRAM 을 다툰다.
SUPERSUB_VLLM_URL=http://127.0.0.1:8000

# 폴링 주기(초). 큐는 대부분 비어 있어서 촘촘히 돌아도 얻는 것이 없고 저널만
# 는다. 작업을 하나 처리한 뒤에는 쉬지 않고 다음 것을 집으므로, 밀린 것이
# 있으면 이 값과 상관없이 연달아 처리된다.
SUPERSUB_POLL_SECONDS=45

# 분석 한 편의 상한(초). 넘으면 자식을 끊고 사유를 남긴 채 failed 로 보고한다 —
# 모델 적재가 멈추면 워커가 그 작업을 영영 붙들고 있어서다.
SUPERSUB_ANALYZE_TIMEOUT=3600
