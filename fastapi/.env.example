# Super-Sub 백엔드 API 환경변수 템플릿
#
#   cp .env.example .env
#
# 실제 값은 여기에 적지 않는다. .env / .env.local 은 .gitignore 에 있다.
#
# 🔴 키 이름의 정본은 팀 저장소 super-sub.cloud 의 .env.example 이다.
#    아래는 이 API 서버가 실제로 읽는 항목만 추린 것이다. 팀 파일에 키가
#    추가·변경되면 그쪽을 따라간다.

# local | dev | prod
APP_ENV=local

# --- Aurora PostgreSQL (pgvector) ------------------------------------------
# 쓰기(라이터) 엔드포인트.
# 형식: <클러스터명>.cluster-<식별자>.<리전>.rds.amazonaws.com
RDS_HOST=
RDS_PORT=5432
RDS_DB_NAME=
RDS_USER=
RDS_PASSWORD=
RDS_SSL_MODE=require

# 위 값들을 조합한 URL. 값이 있으면 개별 항목보다 우선한다.
# 형식: postgresql://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
DATABASE_URL=

# --- 로컬 개발 (WSL 에 설치한 PostgreSQL) ------------------------------------
# .env 에 아래 한 줄이면 된다. 위 RDS_* 항목보다 우선한다.
#   DATABASE_URL=postgresql://supersub:supersub_local@127.0.0.1:5432/supersub
#
# WSL 은 부팅 시 자동 기동되지 않는다. 세션마다 한 번:
#   wsl.exe -d Ubuntu-26.04 -u root -- pg_ctlcluster 18 main start
#
# 스키마는 alembic 이 만든다 (create_all 을 쓰지 않는다):
#   .venv/bin/alembic upgrade head
#   .venv/bin/alembic check     # ORM 과 DB 가 일치하는지. 배포 전에 돌린다

# --- 인증 -------------------------------------------------------------------
# 🔴 없으면 로그인이 503(AUTH_NOT_CONFIGURED)으로 떨어진다. 조용한 기본값은 두지
#    않는다 — 기본값이 있으면 그 값으로 서명한 토큰을 누구나 만들 수 있다.
# 생성:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- 구글 로그인 -------------------------------------------------------------
# 구글 ID 토큰의 aud 로 허용할 클라이언트 ID. **쉼표로 구분해 여러 개를 넣는다.**
# 🔴 안드로이드·iOS·웹이 각각 다른 클라이언트 ID 를 받는다. 하나만 넣으면 나머지
#    플랫폼의 토큰이 전부 401 로 거부된다.
# 발급: https://console.cloud.google.com/apis/credentials
# 비어 있으면 POST /auth/google 이 503(GOOGLE_LOGIN_NOT_CONFIGURED)으로 떨어진다.
GOOGLE_CLIENT_IDS=
